    ENDIF.
    IF lines( lt_potential ) >= lc_page_size.
      DATA lt_potential_full TYPE tt_trend_potential.
      get_potential_bulk( EXPORTING io_client_proxy = io_client_proxy it_user_range = it_user_range IMPORTING et_potential = lt_potential_full ).
      IF lt_potential_full IS NOT INITIAL.
        lt_potential = lt_potential_full.
      ENDIF.
    ENDIF.
    IF lines( lt_roles ) >= lc_page_size.
      DATA lt_roles_full TYPE tt_background_key_roles.
      get_key_roles_bulk( EXPORTING io_client_proxy = io_client_proxy it_user_range = it_user_range IMPORTING et_roles = lt_roles_full ).
      IF lt_roles_full IS NOT INITIAL.
        lt_roles = lt_roles_full.
      ENDIF.
    ENDIF.

    et_languages   = lt_languages.
    et_mobility    = lt_mobility.
    et_regions     = lt_regions.
    et_performance = lt_performance.
    et_potential   = lt_potential.
    et_roles       = lt_roles.
  ENDMETHOD.



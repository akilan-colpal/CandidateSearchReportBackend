    METHOD calculate_duration.
        DATA: lv_years  TYPE i,
              lv_months TYPE i,
              lv_days   TYPE i.
        DATA: lv_current_date TYPE datum.
        DATA: lv_prev_month_date TYPE datum.
        DATA: lv_days_in_prev_month TYPE i.

        IF iv_start_date IS INITIAL.
          RETURN.
        ENDIF.
        TRY.
            lv_current_date = cl_abap_context_info=>get_system_date( ).
          CATCH cx_root.
            lv_current_date = sy-datum.
        ENDTRY.

        IF iv_start_date > lv_current_date.
          rv_duration = '0 Years 0 Months 0 Days'.
          RETURN.
        ENDIF.

        lv_years  = lv_current_date(4)   - iv_start_date(4).
        lv_months = lv_current_date+4(2) - iv_start_date+4(2).
        lv_days   = lv_current_date+6(2) - iv_start_date+6(2).

        IF lv_days < 0.
          lv_months = lv_months - 1.
          lv_prev_month_date = lv_current_date.
          lv_prev_month_date+6(2) = '01'.
          lv_prev_month_date = lv_prev_month_date - 1.

          lv_days_in_prev_month = lv_prev_month_date+6(2).
          lv_days = lv_days + lv_days_in_prev_month.


          IF lv_days < 0.
            lv_months = lv_months - 1.
            lv_prev_month_date+6(2) = '01'.
            lv_prev_month_date = lv_prev_month_date - 1.
            lv_days_in_prev_month = lv_prev_month_date+6(2).
            lv_days = lv_days + lv_days_in_prev_month.
          ENDIF.
        ENDIF.
        IF lv_months < 0.
          lv_years = lv_years - 1.
          lv_months = lv_months + 12.
        ENDIF.

        rv_duration = |{ lv_years } Years { lv_months } Months { lv_days } Days|.
      ENDMETHOD.



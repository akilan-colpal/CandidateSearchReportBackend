CLASS ZCL_EMPLOYEEDATA IMPLEMENTATION.


    METHOD get_reporting_org.
    DATA: lo_request TYPE REF TO /iwbep/if_cp_request_read_list,
          lt_batch   TYPE tt_cust_translate,
          lv_skip    TYPE i VALUE 0.
   DATA lt_range_id TYPE RANGE OF string.
    TRY.
        lt_range_id = VALUE #( ( sign = 'I' option = 'EQ' low = 'REPORTING_ORG' ) ).

        DO.
          lo_request = io_client_proxy->create_resource_for_entity_set( 'CUST_TRANSLATE_DETAILS' )->create_request_for_read( ).
          DATA(lo_filter_factory) = lo_request->create_filter_factory( ).
          DATA(lo_filter) = lo_filter_factory->create_by_range(
              iv_property_path = 'SECONDARY_IDENTIFIER'
              it_range = lt_range_id
          ).
          lo_request->set_filter( lo_filter ).
          lo_request->set_select_properties( VALUE #( ( `SECONDARY_IDENTIFIER` ) ( `CUST_PARAMETER_1` ) ( `CUST_OUTPUT` ) ) ).
          lo_request->set_top( 1000 )->set_skip( lv_skip ).
          lo_request->execute( )->get_business_data( IMPORTING et_business_data = lt_batch ).

          APPEND LINES OF lt_batch TO et_reporting_org.

          IF lines( lt_batch ) < 1000.
            EXIT.
          ENDIF.

          lv_skip = lv_skip + 1000.
        ENDDO.

      CATCH cx_root ##NO_HANDLER.
    ENDTRY.
  ENDMETHOD.


  METHOD get_key_roles_bulk.
    DATA: lo_request TYPE REF TO /iwbep/if_cp_request_read_list,
          lt_batch   TYPE tt_background_key_roles,
          lv_skip    TYPE i VALUE 0.
    TRY.
        DO.
          lo_request = io_client_proxy->create_resource_for_entity_set( 'BACKGROUND_SUGGESTED_NEXT' )->create_request_for_read( ).
          DATA(lo_filter_factory) = lo_request->create_filter_factory( ).
          DATA(lo_filter) = lo_filter_factory->create_by_range( iv_property_path = 'USER_ID' it_range = it_user_range ).
          lo_request->set_filter( lo_filter ).
          lo_request->set_select_properties( VALUE #( ( `USER_ID` ) ( `TITLE` ) ) ).
          lo_request->set_top( 1000 )->set_skip( lv_skip ).
          lo_request->execute( )->get_business_data( IMPORTING et_business_data = lt_batch ).
          APPEND LINES OF lt_batch TO et_roles.
          IF lines( lt_batch ) < 1000. EXIT. ENDIF.
          lv_skip = lv_skip + 1000.
        ENDDO.
      CATCH cx_root ##NO_HANDLER.
    ENDTRY.
  ENDMETHOD.


  METHOD get_employee_data.
    DATA:
      lo_read_list_request TYPE REF TO /iwbep/if_cp_request_read_list.
    DATA:
      lo_filter_factory    TYPE REF TO /iwbep/if_cp_filter_factory,
      lo_filter_node_final TYPE REF TO /iwbep/if_cp_filter_node.

    lo_read_list_request = io_client_proxy->create_resource_for_entity_set( 'EMP_JOB' )->create_request_for_read( ).
    lo_filter_factory = lo_read_list_request->create_filter_factory( ).

    IF it_range_user_id IS NOT INITIAL.
      DATA(lo_filter_node_user) = lo_filter_factory->create_by_range( iv_property_path = 'USER_ID' it_range = it_range_user_id ).
      lo_filter_node_final = COND #( WHEN lo_filter_node_final IS BOUND THEN lo_filter_node_final->and( lo_filter_node_user ) ELSE lo_filter_node_user ).
    ENDIF.
    IF it_range_rep_org IS NOT INITIAL.
      DATA(lo_filter_node_rep_org) = lo_filter_factory->create_by_range( iv_property_path = 'CUSTOM_STRING_121' it_range = it_range_rep_org ).
      lo_filter_node_final = COND #( WHEN lo_filter_node_final IS BOUND THEN lo_filter_node_final->and( lo_filter_node_rep_org ) ELSE lo_filter_node_rep_org ).
    ENDIF.
    IF it_range_pers_area IS NOT INITIAL.
      DATA(lo_filter_node_pers) = lo_filter_factory->create_by_range( iv_property_path = 'LOCATION' it_range = it_range_pers_area ).
      lo_filter_node_final = COND #( WHEN lo_filter_node_final IS BOUND THEN lo_filter_node_final->and( lo_filter_node_pers ) ELSE lo_filter_node_pers ).
    ENDIF.
    IF it_range_country IS NOT INITIAL.
      DATA(lo_filter_node_country) = lo_filter_factory->create_by_range( iv_property_path = 'CUSTOM_STRING_46' it_range = it_range_country ).
      lo_filter_node_final = COND #( WHEN lo_filter_node_final IS BOUND THEN lo_filter_node_final->and( lo_filter_node_country ) ELSE lo_filter_node_country ).
    ENDIF.
    IF it_range_position IS NOT INITIAL.
      DATA(lo_filter_node_position) = lo_filter_factory->create_by_range( iv_property_path = 'POSITION' it_range = it_range_position ).
      lo_filter_node_final = COND #( WHEN lo_filter_node_final IS BOUND THEN lo_filter_node_final->and( lo_filter_node_position ) ELSE lo_filter_node_position ).
    ENDIF.
    IF it_range_emp_status IS NOT INITIAL.
      DATA(lo_filter_node_emp_status) = lo_filter_factory->create_by_range( iv_property_path = 'CUSTOM_STRING_25' it_range = it_range_emp_status ).
      lo_filter_node_final = COND #( WHEN lo_filter_node_final IS BOUND THEN lo_filter_node_final->and( lo_filter_node_emp_status ) ELSE lo_filter_node_emp_status ).
    ENDIF.
    IF it_range_division IS NOT INITIAL.
      DATA(lo_filter_node_division) = lo_filter_factory->create_by_range( iv_property_path = 'CUSTOM_STRING_8' it_range = it_range_division ).
      lo_filter_node_final = COND #( WHEN lo_filter_node_final IS BOUND THEN lo_filter_node_final->and( lo_filter_node_division ) ELSE lo_filter_node_division ).
    ENDIF.
    IF it_range_function IS NOT INITIAL.
      DATA(lo_filter_node_function) = lo_filter_factory->create_by_range( iv_property_path = 'BUSINESS_UNIT' it_range = it_range_function ).
      lo_filter_node_final = COND #( WHEN lo_filter_node_final IS BOUND THEN lo_filter_node_final->and( lo_filter_node_function ) ELSE lo_filter_node_function ).
    ENDIF.
    IF it_range_subfunction IS NOT INITIAL.
      DATA(lo_filter_node_subfunction) = lo_filter_factory->create_by_range( iv_property_path = 'DIVISION' it_range = it_range_subfunction ).
      lo_filter_node_final = COND #( WHEN lo_filter_node_final IS BOUND THEN lo_filter_node_final->and( lo_filter_node_subfunction ) ELSE lo_filter_node_subfunction ).
    ENDIF.
    IF it_range_department IS NOT INITIAL.
      DATA(lo_filter_node_department) = lo_filter_factory->create_by_range( iv_property_path = 'DEPARTMENT' it_range = it_range_department ).
      lo_filter_node_final = COND #( WHEN lo_filter_node_final IS BOUND THEN lo_filter_node_final->and( lo_filter_node_department ) ELSE lo_filter_node_department ).
    ENDIF.
    IF it_range_pay_grade IS NOT INITIAL.
      DATA(lo_filter_node_pay_grade) = lo_filter_factory->create_by_range( iv_property_path = 'PAY_GRADE' it_range = it_range_pay_grade ).
      lo_filter_node_final = COND #( WHEN lo_filter_node_final IS BOUND THEN lo_filter_node_final->and( lo_filter_node_pay_grade ) ELSE lo_filter_node_pay_grade ).
    ENDIF.
    IF it_range_emp_group IS NOT INITIAL.
      DATA(lo_filter_node_emp_group) = lo_filter_factory->create_by_range( iv_property_path = 'EMPLOYEE_CLASS' it_range = it_range_emp_group ).
      lo_filter_node_final = COND #( WHEN lo_filter_node_final IS BOUND THEN lo_filter_node_final->and( lo_filter_node_emp_group ) ELSE lo_filter_node_emp_group ).
    ENDIF.
    IF it_range_category IS NOT INITIAL.
      DATA(lo_filter_node_category) = lo_filter_factory->create_by_range( iv_property_path = 'CUSTOM_STRING_5' it_range = it_range_category ).
      lo_filter_node_final = COND #( WHEN lo_filter_node_final IS BOUND THEN lo_filter_node_final->and( lo_filter_node_category ) ELSE lo_filter_node_category ).
    ENDIF.
    IF it_range_is_salaried IS NOT INITIAL.
      DATA(lo_filter_node_is_salaried) = lo_filter_factory->create_by_range( iv_property_path = 'CUSTOM_STRING_17' it_range = it_range_is_salaried ).
      lo_filter_node_final = COND #( WHEN lo_filter_node_final IS BOUND THEN lo_filter_node_final->and( lo_filter_node_is_salaried ) ELSE lo_filter_node_is_salaried ).
    ENDIF.

    IF lo_filter_node_final IS BOUND.
      lo_read_list_request->set_filter( lo_filter_node_final ).
    ENDIF.

    IF iv_top IS SUPPLIED AND iv_top > 0.
      lo_read_list_request->set_top( iv_top ).
    ELSE.
      lo_read_list_request->set_top( 50 ).
    ENDIF.
    IF iv_skip IS SUPPLIED.
      lo_read_list_request->set_skip( iv_skip ).
    ENDIF.


    lo_read_list_request->set_select_properties( VALUE #( ( `CUSTOM_STRING_25` ) ( `USER_ID` ) ( `CUSTOM_STRING_8` )
      ( `CUSTOM_STRING_46` )  ( `CUSTOM_STRING_121` )  ( `LOCATION` ) ( `CUSTOM_STRING_32` ) ( `BUSINESS_UNIT` ) ( `DIVISION` ) ( `PAY_GRADE` )
      ( `PAY_SCALE_LEVEL_ENTRY_DATE` ) ( `POSITION` ) ( `EMPLOYEE_CLASS` ) ( `CUSTOM_STRING_5` )
      ( `CUSTOM_STRING_17` ) ) ).

    DATA(lo_expand_root) = lo_read_list_request->create_expand_node( ).
    lo_read_list_request->set_orderby( VALUE #( ( property_path = 'USER_ID' ) ) ).

    FINAL(lo_expand_node_emp_nav) = lo_expand_root->add_expand( 'EMPLOYMENT_NAV' ).
    lo_expand_node_emp_nav->set_select_properties( VALUE #( ( `START_DATE` ) ) ).
    FINAL(lo_expand_node_person_nav) = lo_expand_node_emp_nav->add_expand( 'PERSON_NAV' ).
    lo_expand_node_person_nav->add_expand( 'PERSONAL_INFO_NAV' )->set_select_properties(
      VALUE #( ( `PREFERRED_NAME` ) ( `CUSTOM_STRING_1` ) ( `NATIONALITY` ) ( `SECOND_NATIONALITY` ) ( `THIRD_NATIONALITY` ) ( `GENDER` ) ) ).

    FINAL(lo_expand_node_user_nav) = lo_expand_root->add_expand( 'USER_NAV' ).
    lo_expand_node_user_nav->set_select_properties( VALUE #( ( `DATE_IN_POSITION` ) ( `TIMEINPOSITION` )
                                                             ( `TIME_IN_GRADE` ) ( `RISK_OF_LOSS` ) ) ).
    FINAL(lo_expand_node_bu_nav) = lo_expand_root->add_expand( 'BUSINESS_UNIT_NAV' ).
    lo_expand_node_bu_nav->set_select_properties( VALUE #( ( `NAME_EN_US` ) ( `EXTERNAL_CODE` ) ) ).
    FINAL(lo_expand_node_div_nav) = lo_expand_root->add_expand( 'DIVISION_NAV' ).
    lo_expand_node_div_nav->set_select_properties( VALUE #( ( `NAME_EN_US` ) ( `EXTERNAL_CODE` ) ) ).
    FINAL(lo_expand_node_loc_nav) = lo_expand_root->add_expand( 'LOCATION_NAV' ).
    lo_expand_node_loc_nav->set_select_properties( VALUE #( ( `NAME` ) ( `EXTERNAL_CODE` ) ) ).
    FINAL(lo_expand_node_dept_nav) = lo_expand_root->add_expand( 'DEPARTMENT_NAV' ).
    lo_expand_node_dept_nav->set_select_properties( VALUE #( ( `NAME` ) ( `EXTERNAL_CODE` ) ) ).
    lo_read_list_request->request_count( ).

    DATA(lo_response) = lo_read_list_request->execute( ).
    ev_total_count = lo_response->get_count( ).
    lo_response->get_business_data( IMPORTING et_business_data = et_employee_data ).

  ENDMETHOD.


    METHOD if_rap_query_provider~select.
        DATA(top) = io_request->get_paging( )->get_page_size( ).
        DATA(skip) = io_request->get_paging( )->get_offset( ).
        DATA(lo_filter_object) = io_request->get_filter( ).
        DATA lv_total_count TYPE int8.
        DATA lv_debug_log TYPE string.
        lv_debug_log = 'DEBUG:'.

        " Range Tables
        DATA lt_range_user_id     TYPE tt_range_user_id.
        DATA lt_range_pers_area   TYPE tt_range_pers_area.
        DATA lt_range_country     TYPE tt_range_country.
        DATA lt_range_position    TYPE tt_range_position.
        DATA lt_range_emp_status  TYPE tt_range_emp_status.
        DATA lt_range_division    TYPE tt_range_division.
        DATA lt_range_function    TYPE tt_range_function.
        DATA lt_range_subfunction TYPE tt_range_subfunction.
        DATA lt_range_pay_grade   TYPE tt_range_pay_grade.
        DATA lt_range_emp_group   TYPE tt_range_emp_group.
        DATA lt_range_rep_org     TYPE tt_range_rep_org.
        DATA lt_range_category    TYPE tt_range_category.
        DATA lt_range_is_salaried TYPE tt_range_is_salaried.
        DATA lt_range_gender      TYPE tt_range_gender.
        DATA lt_range_potential   TYPE tt_range_potential.

        DATA: ls_range_line TYPE if_rap_query_filter=>ty_range_option.
        DATA: lv_translated_value TYPE string.

        " Output Structure Definition
        TYPES:
         BEGIN OF ty_flat_employee,
           employmentStatus    TYPE zcsrmodel=>tys_emp_job_2-custom_string_25,
           division            TYPE zcsrmodel=>tys_emp_job_2-custom_String_8,
           country             TYPE zcsrmodel=>tys_emp_job_2-custom_String_46,
           personnelArea       TYPE string,
           positionTitle       TYPE zcsrmodel=>tys_emp_job_2-custom_String_32,
           positionCode        TYPE zcsrmodel=>tys_emp_job_2-position,
           isSalaried          TYPE zcsrmodel=>tys_emp_job_2-custom_String_17,
           category            TYPE zcsrmodel=>tys_emp_job_2-custom_String_5,
           reportingOrg        TYPE zcsrmodel=>tys_emp_job_2-custom_String_122,
           employeeGroup       TYPE zcsrmodel=>tys_emp_job_2-employee_class,
           function            TYPE string,
           subfunction         TYPE string,
           personalSalaryGrade TYPE zcsrmodel=>tys_emp_job_2-pay_grade,
           dateInGrade         TYPE zcsrmodel=>tys_emp_job_2-pay_scale_level_entry_date,
           first_name          TYPE zcsrmodel=>tys_per_personal_2-preferred_name,
           last_name           TYPE zcsrmodel=>tys_per_personal_2-custom_String_1,
           nationality         TYPE zcsrmodel=>tys_per_personal_2-nationality,
           second_nationality  TYPE zcsrmodel=>tys_per_personal_2-second_nationality,
           thirdNationality    TYPE zcsrmodel=>tys_per_personal_2-third_nationality,
           gender              TYPE string,
           globalColgateID     TYPE zcsrmodel=>tys_emp_job_2-user_id,
           dateInPosition      TYPE zcsrmodel=>tys_user_2-date_in_position,
           timeInPosition      TYPE zcsrmodel=>tys_user_2-timeinposition,
           timeInGrade         TYPE zcsrmodel=>tys_user_2-time_in_grade,
           riskOfLoss          TYPE zcsrmodel=>tys_user_2-risk_of_loss,
           potential_rating    TYPE string,
           mobility_willingness TYPE string,
           mobility_regions    TYPE string,
           mobility_timing     TYPE string,
           mobility_comments   TYPE string,
           key_role_1          TYPE string,
           key_role_2          TYPE string,
           key_role_3          TYPE string,
           performance_year    TYPE string,
           performance_rating  TYPE string,
           language_1          TYPE string,
           fluency_1           TYPE string,
           language_2          TYPE string,
           fluency_2           TYPE string,
           language_3          TYPE string,
           fluency_3           TYPE string,
           language_4          TYPE string,
           fluency_4           TYPE string,
           language_5          TYPE string,
           fluency_5           TYPE string,
           END OF ty_flat_employee.

        DATA lt_employee_data_flat   TYPE TABLE OF ty_flat_employee.
        DATA lt_employee_data_nested TYPE t_employee_data_table.

        " Proxy Setup
        DATA lo_proxy_mgr TYPE REF TO zcl_csr_odata_proxy.
        DATA lo_proxy     TYPE REF TO /iwbep/if_cp_client_proxy.
        TRY.
            lo_proxy_mgr = NEW #( ).
            lo_proxy = lo_proxy_mgr->get_odatav2_client_proxy( ).
          CATCH cx_root ##NO_HANDLER.
            io_response->set_total_number_of_records( 0 ).
            io_response->set_data( lt_employee_data_flat ).
            RETURN.
        ENDTRY.

        TRY.
            me->get_picklist( io_client_proxy = lo_proxy ).
          CATCH cx_root ##NO_HANDLER.
        ENDTRY.

        " Filter Parsing
        IF lo_filter_object IS BOUND.
          TRY.
              DATA(lt_all_filter_ranges) = lo_filter_object->get_as_ranges( ).
              CATCH cx_rap_query_filter_no_range ##NO_HANDLER.
          ENDTRY.
        ENDIF.

        LOOP AT lt_all_filter_ranges INTO FINAL(ls_filter).
          CASE ls_filter-name.
            WHEN 'GLOBALCOLGATEID'.
              LOOP AT ls_filter-range INTO ls_range_line.
                APPEND VALUE #( sign = ls_range_line-sign option = ls_range_line-option low = ls_range_line-low high = ls_range_line-high ) TO lt_range_user_id.
              ENDLOOP.
            WHEN 'GENDER'.
              LOOP AT ls_filter-range INTO ls_range_line.
                 APPEND VALUE #( sign = ls_range_line-sign option = ls_range_line-option low = ls_range_line-low high = ls_range_line-high ) TO lt_range_gender.
              ENDLOOP.
            WHEN 'PERSONNELAREA'.
              LOOP AT ls_filter-range INTO ls_range_line.
                APPEND VALUE #( sign = ls_range_line-sign option = ls_range_line-option low = ls_range_line-low high = ls_range_line-high ) TO lt_range_pers_area.
              ENDLOOP.
            WHEN 'COUNTRY'.
              LOOP AT ls_filter-range INTO ls_range_line.
                 TRY. lv_translated_value = mt_picklist[ pick_list_v_2_id = 'ISOCountryList' external_code = ls_range_line-low ]-option_id. CATCH cx_sy_itab_line_not_found. lv_translated_value = ls_range_line-low. ENDTRY.
                 APPEND VALUE #( sign = ls_range_line-sign option = ls_range_line-option low = lv_translated_value high = ls_range_line-high ) TO lt_range_country.
              ENDLOOP.
            WHEN 'POSITIONCODE'.
              LOOP AT ls_filter-range INTO ls_range_line.
                APPEND VALUE #( sign = ls_range_line-sign option = ls_range_line-option low = ls_range_line-low high = ls_range_line-high ) TO lt_range_position.
              ENDLOOP.
            WHEN 'EMPLOYMENTSTATUS'.
              LOOP AT ls_filter-range INTO ls_range_line.
                 TRY. lv_translated_value = mt_picklist[ pick_list_v_2_id = 'employee-status' external_code = ls_range_line-low ]-option_id. CATCH cx_sy_itab_line_not_found. lv_translated_value = ls_range_line-low. ENDTRY.
                 APPEND VALUE #( sign = ls_range_line-sign option = ls_range_line-option low = lv_translated_value high = ls_range_line-high ) TO lt_range_emp_status.
              ENDLOOP.
             WHEN 'DIVISION'.
              LOOP AT ls_filter-range INTO ls_range_line.
                 APPEND VALUE #( sign = ls_range_line-sign option = ls_range_line-option low = ls_range_line-low high = ls_range_line-high ) TO lt_range_division.
              ENDLOOP.
             WHEN 'FUNCTION'.
              LOOP AT ls_filter-range INTO ls_range_line.
                APPEND VALUE #( sign = ls_range_line-sign option = ls_range_line-option low = ls_range_line-low high = ls_range_line-high ) TO lt_range_function.
              ENDLOOP.
             WHEN 'SUBFUNCTION'.
              LOOP AT ls_filter-range INTO ls_range_line.
                APPEND VALUE #( sign = ls_range_line-sign option = ls_range_line-option low = ls_range_line-low high = ls_range_line-high ) TO lt_range_subfunction.
              ENDLOOP.
             WHEN 'PERSONALSALARYGRADE'.
              LOOP AT ls_filter-range INTO ls_range_line.
                APPEND VALUE #( sign = ls_range_line-sign option = ls_range_line-option low = ls_range_line-low high = ls_range_line-high ) TO lt_range_pay_grade.
              ENDLOOP.
             WHEN 'EMPLOYEEGROUP'.
              LOOP AT ls_filter-range INTO ls_range_line.
                 TRY. lv_translated_value = mt_picklist[ pick_list_v_2_id = 'EmployeeClass' external_code = ls_range_line-low ]-option_id. CATCH cx_sy_itab_line_not_found. lv_translated_value = ls_range_line-low. ENDTRY.
                 APPEND VALUE #( sign = ls_range_line-sign option = ls_range_line-option low = lv_translated_value high = ls_range_line-high ) TO lt_range_emp_group.
              ENDLOOP.
             WHEN 'REPORTINGORG'.
              LOOP AT ls_filter-range INTO ls_range_line.
                APPEND VALUE #( sign = ls_range_line-sign option = ls_range_line-option low = ls_range_line-low high = ls_range_line-high ) TO lt_range_rep_org.
              ENDLOOP.
             WHEN 'CATEGORY'.
              LOOP AT ls_filter-range INTO ls_range_line.
                 TRY. lv_translated_value = mt_picklist[ pick_list_v_2_id = 'CP_Category' external_code = ls_range_line-low ]-option_id. CATCH cx_sy_itab_line_not_found. lv_translated_value = ls_range_line-low. ENDTRY.
                 APPEND VALUE #( sign = ls_range_line-sign option = ls_range_line-option low = lv_translated_value high = ls_range_line-high ) TO lt_range_category.
              ENDLOOP.
             WHEN 'ISSALARIED'.
              LOOP AT ls_filter-range INTO ls_range_line.
                 TRY. lv_translated_value = mt_picklist[ pick_list_v_2_id = 'yesNo' external_code = ls_range_line-low ]-option_id. CATCH cx_sy_itab_line_not_found. lv_translated_value = ls_range_line-low. ENDTRY.
                 APPEND VALUE #( sign = ls_range_line-sign option = ls_range_line-option low = lv_translated_value high = ls_range_line-high ) TO lt_range_is_salaried.
              ENDLOOP.
              WHEN 'POTENTIAL_RATING'.
              LOOP AT ls_filter-range INTO ls_range_line.

                APPEND VALUE #( sign = ls_range_line-sign option = ls_range_line-option low = ls_range_line-low high = ls_range_line-high ) TO lt_range_potential.
              ENDLOOP.
          ENDCASE.
        ENDLOOP.
    lv_debug_log = |{ lv_debug_log } [Filters: Area={ lines( lt_range_pers_area ) } Gen={ lines( lt_range_gender ) } Pot={ lines( lt_range_potential ) }]|.
    " -----------------------------------------------------------------
        " GENDER PRE-FETCH LOGIC
        " -----------------------------------------------------------------
        IF lt_range_gender IS NOT INITIAL.
            DATA lt_gender_users TYPE tt_range_user_id.
            TRY.
                me->get_users_by_gender(
                   EXPORTING io_client_proxy = lo_proxy it_range_gender = lt_range_gender
                   IMPORTING et_user_ids     = lt_gender_users
                ).

                SORT lt_gender_users BY low.

                IF lt_range_user_id IS INITIAL.
                    lt_range_user_id = lt_gender_users.
                ELSE.
                    DATA lt_final_users TYPE tt_range_user_id.

                    LOOP AT lt_range_user_id INTO DATA(ls_uid).

                       READ TABLE lt_gender_users TRANSPORTING NO FIELDS
                            WITH KEY low = ls_uid-low BINARY SEARCH.

                       IF sy-subrc = 0.
                           APPEND ls_uid TO lt_final_users.
                       ENDIF.
                    ENDLOOP.
                    lt_range_user_id = lt_final_users.
                ENDIF.

                IF lt_gender_users IS INITIAL OR ( lt_range_user_id IS INITIAL AND lt_gender_users IS NOT INITIAL ).
                     CLEAR lt_range_user_id. " Clear previous data
                     APPEND VALUE #( sign = 'I' option = 'EQ' low = 'NO_MATCH_FOUND' ) TO lt_range_user_id.
                ENDIF.
            CATCH cx_root ##NO_HANDLER.
            ENDTRY.
        ENDIF.
        " -----------------------------------------------------------------
        " POTENTIAL RATING PRE-FETCH LOGIC
        " -----------------------------------------------------------------
        IF lt_range_potential IS NOT INITIAL.
            DATA lt_potential_users TYPE tt_range_user_id.
            TRY.
                me->get_users_by_potential(
                   EXPORTING io_client_proxy = lo_proxy it_range_potential = lt_range_potential
                   IMPORTING et_user_ids     = lt_potential_users
                ).

                SORT lt_potential_users BY low.

                IF lt_range_user_id IS INITIAL.
                    lt_range_user_id = lt_potential_users.
                ELSE.
                    DATA lt_final_users_pot TYPE tt_range_user_id.
                    LOOP AT lt_range_user_id INTO DATA(ls_uid_pot).
                       READ TABLE lt_potential_users TRANSPORTING NO FIELDS
                            WITH KEY low = ls_uid_pot-low BINARY SEARCH.
                       IF sy-subrc = 0.
                           APPEND ls_uid_pot TO lt_final_users_pot.
                       ENDIF.
                    ENDLOOP.
                    lt_range_user_id = lt_final_users_pot.
                ENDIF.

                IF lt_potential_users IS INITIAL OR ( lt_range_user_id IS INITIAL AND lt_potential_users IS NOT INITIAL ).
                     CLEAR lt_range_user_id.
                     APPEND VALUE #( sign = 'I' option = 'EQ' low = 'NO_MATCH_FOUND' ) TO lt_range_user_id.
                ENDIF.
            CATCH cx_root ##NO_HANDLER.
            ENDTRY.
        ENDIF.

    lv_debug_log = |{ lv_debug_log } [MainQueryIDs: { lines( lt_range_user_id ) }]|.
        CONSTANTS lc_emp_batch_size TYPE i VALUE 150.
        DATA lt_main_batch_ids      TYPE tt_range_user_id.
        DATA lt_main_batch_result   TYPE t_employee_data_table.
        IF lt_range_user_id IS NOT INITIAL.

            DATA(lv_req_top)  = io_request->get_paging( )->get_page_size( ).
            DATA(lv_req_skip) = io_request->get_paging( )->get_offset( ).
            IF lv_req_top <= 0. lv_req_top = 50. ENDIF.

            DATA(lv_matches_found)   = 0.
            DATA(lv_matches_skipped) = 0.

            DATA(lv_candidate_total) = lines( lt_range_user_id ).
            DATA(lv_candidate_idx)   = 1.
            CONSTANTS lc_process_batch TYPE i VALUE 150. " Check 150 candidates at a time

            WHILE lv_candidate_idx <= lv_candidate_total.

                IF lv_matches_found >= lv_req_top.
                    EXIT.
                ENDIF.

                CLEAR: lt_main_batch_ids, lt_main_batch_result.
                DATA(lv_candidate_end) = lv_candidate_idx + lc_process_batch - 1.
                IF lv_candidate_end > lv_candidate_total. lv_candidate_end = lv_candidate_total. ENDIF.

                APPEND LINES OF lt_range_user_id FROM lv_candidate_idx TO lv_candidate_end TO lt_main_batch_ids.

                TRY.
                    me->get_employee_data(
                      EXPORTING
                        io_client_proxy      = lo_proxy
                        it_range_user_id     = lt_main_batch_ids
                        it_range_pers_area   = lt_range_pers_area
                        it_range_country     = lt_range_country
                        it_range_position    = lt_range_position
                        it_range_emp_status  = lt_range_emp_status
                        it_range_division    = lt_range_division
                        it_range_function    = lt_range_function
                        it_range_subfunction = lt_range_subfunction
                        it_range_pay_grade   = lt_range_pay_grade
                        it_range_emp_group   = lt_range_emp_group
                        it_range_rep_org     = lt_range_rep_org
                        it_range_category    = lt_range_category
                        it_range_is_salaried = lt_range_is_salaried
                        iv_top               = 0
                        iv_skip              = 0
                      IMPORTING
                        et_employee_data     = lt_main_batch_result
                    ).

                    LOOP AT lt_main_batch_result INTO DATA(ls_match).

                        IF lv_matches_skipped < lv_req_skip.
                            lv_matches_skipped = lv_matches_skipped + 1.
                            CONTINUE.
                        ENDIF.

                        IF lv_matches_found < lv_req_top.
                            APPEND ls_match TO lt_employee_data_nested.
                            lv_matches_found = lv_matches_found + 1.
                        ELSE.
                            EXIT.
                        ENDIF.
                    ENDLOOP.

                CATCH cx_root ##NO_HANDLER.
                ENDTRY.

                lv_candidate_idx = lv_candidate_end + 1.
            ENDWHILE.


            lv_total_count = lv_candidate_total.

        ELSE.
            TRY.
                me->get_employee_data(
                  EXPORTING
                    io_client_proxy      = lo_proxy
                    it_range_pers_area   = lt_range_pers_area
                    it_range_country     = lt_range_country
                    it_range_position    = lt_range_position
                    it_range_emp_status  = lt_range_emp_status
                    it_range_division    = lt_range_division
                    it_range_function    = lt_range_function
                    it_range_subfunction = lt_range_subfunction
                    it_range_pay_grade   = lt_range_pay_grade
                    it_range_emp_group   = lt_range_emp_group
                    it_range_rep_org     = lt_range_rep_org
                    it_range_category    = lt_range_category
                    it_range_is_salaried = lt_range_is_salaried
                    iv_top               = CONV i( top )
                    iv_skip              = CONV i( skip )
                  IMPORTING
                    et_employee_data     = lt_employee_data_nested
                    ev_total_count       = lv_total_count
                ).
              CATCH cx_root.
                 io_response->set_total_number_of_records( 0 ).
                 io_response->set_data( lt_employee_data_flat ).
                 RETURN.
            ENDTRY.
        ENDIF.

        IF lt_employee_data_nested IS INITIAL.
          io_response->set_total_number_of_records( 0 ).
          io_response->set_data( lt_employee_data_flat ).
          RETURN.
        ENDIF.

        DATA lt_all_user_ids TYPE TABLE OF zcsrmodel=>tys_emp_job_2-user_id.
        lt_all_user_ids = VALUE #( FOR emp IN lt_employee_data_nested ( emp-user_id ) ).

        DATA: lt_bulk_languages   TYPE tt_background_languages,
              lt_bulk_mobility    TYPE tt_background_mobility,
              lt_bulk_regions     TYPE tt_background_regions,
              lt_bulk_performance TYPE tt_trend_performance,
              lt_bulk_potential   TYPE tt_trend_potential,
              lt_bulk_roles       TYPE tt_background_key_roles.

        DATA: lt_chunk_languages   TYPE tt_background_languages,
              lt_chunk_mobility    TYPE tt_background_mobility,
              lt_chunk_regions     TYPE tt_background_regions,
              lt_chunk_performance TYPE tt_trend_performance,
              lt_chunk_potential   TYPE tt_trend_potential,
              lt_chunk_roles       TYPE tt_background_key_roles.

        DATA lt_chunk_user_ids TYPE TABLE OF zcsrmodel=>tys_emp_job_2-user_id.
        DATA lt_batch_range TYPE tt_range_user_id.

        " BATCHING FOR BACKGROUND DATA
        CONSTANTS lc_bg_batch_size TYPE i VALUE 170.

        IF lt_all_user_ids IS NOT INITIAL.
            DATA(lv_total_users) = lines( lt_all_user_ids ).
            DATA(lv_batch_start) = 1.

            WHILE lv_batch_start <= lv_total_users.
                CLEAR: lt_chunk_user_ids, lt_batch_range, lt_chunk_languages, lt_chunk_mobility, lt_chunk_regions, lt_chunk_performance, lt_chunk_potential, lt_chunk_roles.

                DATA(lv_batch_end) = lv_batch_start + lc_bg_batch_size - 1.
                IF lv_batch_end > lv_total_users.
                    lv_batch_end = lv_total_users.
                ENDIF.
                APPEND LINES OF lt_all_user_ids FROM lv_batch_start TO lv_batch_end TO lt_chunk_user_ids.

                lt_batch_range = VALUE #( FOR u_id IN lt_chunk_user_ids ( sign = 'I' option = 'EQ' low = u_id ) ).

                TRY.
                    me->get_background_batch(
                      EXPORTING
                        io_client_proxy = lo_proxy
                        it_user_range   = lt_batch_range
                      IMPORTING
                        et_languages    = lt_chunk_languages
                        et_mobility     = lt_chunk_mobility
                        et_regions      = lt_chunk_regions
                        et_performance  = lt_chunk_performance
                        et_potential    = lt_chunk_potential
                        et_roles        = lt_chunk_roles ).
                    APPEND LINES OF lt_chunk_languages TO lt_bulk_languages.
                    APPEND LINES OF lt_chunk_mobility TO lt_bulk_mobility.
                    APPEND LINES OF lt_chunk_regions TO lt_bulk_regions.
                    APPEND LINES OF lt_chunk_performance TO lt_bulk_performance.
                    APPEND LINES OF lt_chunk_potential TO lt_bulk_potential.
                    APPEND LINES OF lt_chunk_roles TO lt_bulk_roles.
                CATCH cx_root ##NO_HANDLER.
                ENDTRY.
                lv_batch_start = lv_batch_end + 1.
            ENDWHILE.
        ENDIF.

        SORT lt_bulk_languages BY user_id.
        SORT lt_bulk_mobility BY user_id.
        SORT lt_bulk_regions BY user_id.
        SORT lt_bulk_performance BY user_id.
        SORT lt_bulk_potential BY external_code.
        SORT lt_bulk_roles BY user_id.

        " MAPPING LOGIC
        DATA ls_flat_employee TYPE ty_flat_employee.

        LOOP AT lt_employee_data_nested ASSIGNING FIELD-SYMBOL(<fs_employee>).
          CLEAR ls_flat_employee.
          ls_flat_employee = CORRESPONDING #( <fs_employee> MAPPING
              globalColgateID       = user_id
              personnelArea         = location
              positionTitle         = custom_string_32
              personalSalaryGrade = pay_grade
              dateInGrade           = pay_scale_level_entry_date
              positionCode          = position
           ).

          " Navigation Properties
          ls_flat_employee-first_name = VALUE #( <fs_employee>-employment_nav[ 1 ]-person_nav-personal_info_nav[ 1 ]-preferred_name OPTIONAL ).
          ls_flat_employee-last_name  = VALUE #( <fs_employee>-employment_nav[ 1 ]-person_nav-personal_info_nav[ 1 ]-custom_string_1 OPTIONAL ).
          ls_flat_employee-nationality = VALUE #( <fs_employee>-employment_nav[ 1 ]-person_nav-personal_info_nav[ 1 ]-nationality OPTIONAL ).
          ls_flat_employee-second_nationality = VALUE #( <fs_employee>-employment_nav[ 1 ]-person_nav-personal_info_nav[ 1 ]-second_nationality OPTIONAL ).
          ls_flat_employee-thirdNationality = VALUE #( <fs_employee>-employment_nav[ 1 ]-person_nav-personal_info_nav[ 1 ]-third_nationality OPTIONAL ).
          ls_flat_employee-gender = VALUE #( <fs_employee>-employment_nav[ 1 ]-person_nav-personal_info_nav[ 1 ]-gender OPTIONAL ).

          ls_flat_employee-dateInPosition = VALUE #( <fs_employee>-user_nav[ 1 ]-date_in_position OPTIONAL ).
          ls_flat_employee-function = VALUE #( <fs_employee>-business_unit_nav[ 1 ]-name_en_us OPTIONAL ).
          ls_flat_employee-subfunction = VALUE #( <fs_employee>-division_nav[ 1 ]-name_en_us OPTIONAL ).
          ls_flat_employee-personnelArea = VALUE #( <fs_employee>-location_nav[ 1 ]-name OPTIONAL ).


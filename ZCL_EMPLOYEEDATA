METHOD get_picklist.
    CONSTANTS lc_top TYPE i VALUE 500.

    DATA lo_read_list_request TYPE REF TO /iwbep/if_cp_request_read_list.
    DATA lt_page_data         TYPE tt_pick_list_value.
    DATA lv_skip              TYPE i VALUE 0.
    DATA lv_count             TYPE i.

    DATA lt_status_range TYPE RANGE OF zcsrmodel=>tys_pick_list_value_v_2_2-status.
    DATA lt_id_range     TYPE RANGE OF zcsrmodel=>tys_pick_list_value_v_2_2-pick_list_v_2_id.

    TRY.
        lt_status_range = VALUE #( ( sign = 'I' option = 'EQ' low = 'A' ) ).

        lt_id_range = VALUE #(
           ( sign = 'I' option = 'EQ' low = 'employee-status' )
           ( sign = 'I' option = 'EQ' low = 'ISOCountryList' )
           ( sign = 'I' option = 'EQ' low = 'language' )
           ( sign = 'I' option = 'EQ' low = 'fluency~%1' )
           ( sign = 'I' option = 'EQ' low = 'cust_division' )
           ( sign = 'I' option = 'EQ' low = 'riskOfLoss' )
           ( sign = 'I' option = 'EQ' low = 'potRating' )
           ( sign = 'I' option = 'EQ' low = 'IDP_Willingness_to_Relocate' )
           ( sign = 'I' option = 'EQ' low = 'IDP_Relocation_Timeline' )
           ( sign = 'I' option = 'EQ' low = 'NextRoles' )
           ( sign = 'I' option = 'EQ' low = 'EmployeeClass' )
           ( sign = 'I' option = 'EQ' low = 'CP_Category' )
           ( sign = 'I' option = 'EQ' low = 'yesNo' )
           ( sign = 'I' option = 'EQ' low = 'reloyears' )
           ( sign = 'I' option = 'EQ' low = 'CP_Reporting_Org' )

        ).
        lo_read_list_request = io_client_proxy->create_resource_for_entity_set( 'PICK_LIST_VALUE_V_2' )->create_request_for_read( ).
        DATA(lo_factory_cnt) = lo_read_list_request->create_filter_factory( ).
        DATA(lo_node_cnt) = lo_factory_cnt->create_by_range( iv_property_path = 'STATUS' it_range = lt_status_range )->and(
                            lo_factory_cnt->create_by_range( iv_property_path = 'PICK_LIST_V_2_ID' it_range = lt_id_range ) ).
        lo_read_list_request->set_filter( lo_node_cnt ).
        lv_count = lo_read_list_request->request_count( )->request_no_business_data( )->execute( )->get_count( ).
        CLEAR mt_picklist.

        WHILE lv_count > 0.
            FINAL(lo_req_page) = io_client_proxy->create_resource_for_entity_set( 'PICK_LIST_VALUE_V_2' )->create_request_for_read( ).
            DATA(lo_factory) = lo_req_page->create_filter_factory( ).
            DATA(lo_node) = lo_factory->create_by_range( iv_property_path = 'STATUS' it_range = lt_status_range )->and(
                            lo_factory->create_by_range( iv_property_path = 'PICK_LIST_V_2_ID' it_range = lt_id_range ) ).

            lo_req_page->set_filter( lo_node ).
            lo_req_page->set_top( lc_top )->set_skip( lv_skip ).

            lo_req_page->set_select_properties( VALUE #( ( `LABEL_EN_US` ) ( `PICK_LIST_V_2_ID` ) ( `OPTION_ID` ) ( `EXTERNAL_CODE` ) ( `STATUS` ) ) ).
            lo_req_page->set_orderby( VALUE #( ( property_path = 'PICK_LIST_V_2_ID' ) ) ).

            lo_req_page->execute( )->get_business_data( IMPORTING et_business_data = lt_page_data ).

            APPEND LINES OF lt_page_data TO mt_picklist.

            lv_count -= lc_top.
            lv_skip += lc_top.
        ENDWHILE.

      CATCH cx_root INTO DATA(lx_err).
        mv_debug_error = lx_err->get_text( ).
    ENDTRY.
  ENDMETHOD.


  METHOD get_potential_bulk.
    DATA: lo_request TYPE REF TO /iwbep/if_cp_request_read_list,

    ENDIF.
          TRY. ls_flat_employee-employeeGroup = mt_picklist[ option_id = <fs_employee>-employee_class pick_list_v_2_id = 'EmployeeClass' ]-label_en_us. CATCH cx_sy_itab_line_not_found ##NO_HANDLER.
          ls_flat_employee-employeeGroup = <fs_employee>-employee_class. ENDTRY.
          TRY. ls_flat_employee-category = mt_picklist[ option_id = <fs_employee>-custom_string_5 pick_list_v_2_id = 'CP_Category' ]-label_en_us. CATCH cx_sy_itab_line_not_found ##NO_HANDLER.
ls_flat_employee-category = <fs_employee>-custom_string_5.
ENDTRY.
          TRY. ls_flat_employee-isSalaried = mt_picklist[ option_id = <fs_employee>-custom_string_17 pick_list_v_2_id = 'yesNo' ]-label_en_us. CATCH cx_sy_itab_line_not_found ##NO_HANDLER. ls_flat_employee-isSalaried = <fs_employee>-custom_string_17.
ENDTRY.

          " Background Mappings
          READ TABLE lt_bulk_mobility INTO DATA(ls_mob) WITH KEY user_id = <fs_employee>-user_id BINARY SEARCH.
          IF sy-subrc = 0.
             TRY. ls_flat_employee-mobility_willingness = mt_picklist[ option_id = ls_mob-willingness pick_list_v_2_id = 'IDP_Willingness_to_Relocate' ]-label_en_us. CATCH cx_sy_itab_line_not_found ##NO_HANDLER.
             ls_flat_employee-mobility_willingness = ls_mob-willingness.
    ENDTRY.
             ls_flat_employee-mobility_comments = ls_mob-comments.
             DATA(lv_year_lbl) = ls_mob-timingyear.
             TRY. lv_year_lbl = mt_picklist[ option_id = ls_mob-timingyear pick_list_v_2_id = 'reloyears' ]-label_en_us. CATCH cx_sy_itab_line_not_found ##NO_HANDLER. ENDTRY.
             IF ls_mob-timingquarter IS NOT INITIAL.
                 DATA(lv_timing_lbl) = ls_mob-timingquarter.
                 TRY. lv_timing_lbl = mt_picklist[ option_id = ls_mob-timingquarter pick_list_v_2_id = 'IDP_Relocation_Timeline' ]-label_en_us. CATCH cx_sy_itab_line_not_found ##NO_HANDLER. ENDTRY.
               ls_flat_employee-mobility_timing = |{ lv_timing_lbl }, { lv_year_lbl }|.
             ELSE.
                ls_flat_employee-mobility_timing = lv_year_lbl.
             ENDIF.
          ENDIF.

          READ TABLE lt_bulk_regions INTO DATA(ls_reg) WITH KEY user_id = <fs_employee>-user_id BINARY SEARCH.
          IF sy-subrc = 0. ls_flat_employee-mobility_regions = ls_reg-region_list. ENDIF.

          READ TABLE lt_bulk_performance INTO DATA(ls_perf) WITH KEY user_id = <fs_employee>-user_id BINARY SEARCH.
          IF sy-subrc = 0. ls_flat_employee-performance_rating = ls_perf-ratings. IF ls_perf-startdate IS NOT INITIAL. ls_flat_employee-performance_year = ls_perf-startdate(4). ENDIF. ENDIF.

          READ TABLE lt_bulk_potential INTO DATA(ls_pot) WITH KEY external_code = <fs_employee>-user_id BINARY SEARCH.
          IF sy-subrc = 0. TRY. ls_flat_employee-potential_rating = mt_picklist[ external_code = ls_pot-cust_potential_rating pick_list_v_2_id = 'potRating' ]-label_en_us. CATCH cx_sy_itab_line_not_found ##NO_HANDLER.
           ls_flat_employee-potential_rating = ls_pot-cust_potential_rating.

METHOD get_users_by_gender.
    TYPES: BEGIN OF ty_per_personal_short,
             person_id_external TYPE zcsrmodel=>tys_emp_job_2-user_id,
           END OF ty_per_personal_short.
    DATA: lt_results TYPE TABLE OF ty_per_personal_short.
    DATA: lo_request TYPE REF TO /iwbep/if_cp_request_read_list.
    DATA: lv_skip TYPE i VALUE 0.
    DO.
      TRY.
        lo_request = io_client_proxy->create_resource_for_entity_set( 'PER_PERSONAL' )->create_request_for_read( ).
        DATA(lo_filter_factory) = lo_request->create_filter_factory( ).
        DATA(lo_filter) = lo_filter_factory->create_by_range( iv_property_path = 'GENDER' it_range = it_range_gender ).

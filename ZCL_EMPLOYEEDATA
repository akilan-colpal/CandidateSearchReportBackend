        lo_request->set_select_properties( VALUE #( ( `PERSON_ID_EXTERNAL` ) ) ).
        lo_request->set_top( 1000 )->set_skip( lv_skip ).
        lo_request->execute( )->get_business_data( IMPORTING et_business_data = lt_results ).
        LOOP AT lt_results INTO DATA(ls_res).
             IF ls_res-person_id_external NA '_'.
                APPEND VALUE #( sign = 'I' option = 'EQ' low = ls_res-person_id_external ) TO et_user_ids.

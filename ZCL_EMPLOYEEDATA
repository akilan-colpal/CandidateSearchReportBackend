          " Picklist Mappings
          TRY. ls_flat_employee-country = mt_picklist[ option_id = <fs_employee>-custom_string_46 pick_list_v_2_id = 'ISOCountryList' ]-external_code. CATCH cx_sy_itab_line_not_found ##NO_HANDLER. ls_flat_employee-country = <fs_employee>-custom_string_46
.
    ENDTRY.
          TRY. ls_flat_employee-employmentStatus = mt_picklist[ option_id = <fs_employee>-custom_string_25 pick_list_v_2_id = 'employee-status' ]-label_en_us. CATCH cx_sy_itab_line_not_found ##NO_HANDLER.

CLASS zcl_csr_schedule_job DEFINITION
    PUBLIC
    FINAL

    CREATE PUBLIC .
    PUBLIC SECTION.
    INTERFACES if_rap_query_provider.

    PROTECTED SECTION.

    PRIVATE SECTION.


    DATA mt_parameter TYPE cl_apj_rt_api=>tt_job_parameter_value.

    " Internal ranges

    DATA: mt_range_userid TYPE zcl_employeedata=>tt_range_user_id,
        mt_range_area TYPE zcl_employeedata=>tt_range_pers_area,
        mt_range_country TYPE zcl_employeedata=>tt_range_country,
        mt_range_pos TYPE zcl_employeedata=>tt_range_position,
        mt_range_status TYPE zcl_employeedata=>tt_range_emp_status,
        mt_range_division TYPE zcl_employeedata=>tt_range_division,
        mt_range_department TYPE zcl_employeedata=>tt_range_department,
        mt_range_func TYPE zcl_employeedata=>tt_range_function,
        mt_range_subfunc TYPE zcl_employeedata=>tt_range_subfunction,
        mt_range_grade TYPE zcl_employeedata=>tt_range_pay_grade,
        mt_range_empgroup TYPE zcl_employeedata=>tt_range_emp_group,
        mt_range_reporg TYPE zcl_employeedata=>tt_range_rep_org,
        mt_range_category TYPE zcl_employeedata=>tt_range_category,
        mt_range_new_hire TYPE zcl_employeedata=>tt_range_new_hire,
        mt_range_is_salaried TYPE zcl_employeedata=>tt_range_is_salaried,
        mt_range_gender TYPE zcl_employeedata=>tt_range_gender,
        mt_range_potential TYPE zcl_employeedata=>tt_range_potential.


    TYPES: BEGIN OF ty_response,
        jobcount TYPE string,
        jobname TYPE string,
        message TYPE string,
        reportid TYPE string,

    END OF ty_response.

    DATA: lt_response TYPE TABLE OF ty_response.

ENDCLASS.



CLASS ZCL_CSR_SCHEDULE_JOB IMPLEMENTATION.


    METHOD if_rap_query_provider~select.

        DATA: lv_status TYPE string,
        lv_error_message TYPE string,
        lv_numeric_id TYPE string.

        TRY.

            DATA(lt_req_elements) = io_request->get_requested_elements( ).
            DATA(ls_paging) = io_request->get_paging( ).
            CATCH cx_rap_query_provider ##NO_HANDLER.
        ENDTRY.

        IF io_request->is_data_requested( ).

        TRY.
            DATA(lt_ranges) = io_request->get_filter( )->get_as_ranges( ).
            CATCH cx_rap_query_filter_no_range ##NO_HANDLER.
        ENDTRY.

        LOOP AT lt_ranges INTO DATA(ls_range).
            CASE ls_range-name.
                WHEN 'GLOBALCOLGATEID'. mt_range_userid = VALUE #( FOR ls_r IN ls_range-range (
                              sign   = ls_r-sign
                              low    = ls_r-low
                              option = COND #( WHEN ls_r-low CS '*' OR ls_r-low CS '%' THEN 'CP'
                                               WHEN ls_r-low CS '!' THEN 'NE'
                                               ELSE ls_r-option )
                          ) ).
                 WHEN 'DEPARTMENT'. mt_range_department = VALUE #( FOR ls_r IN ls_range-range (
                              sign   = ls_r-sign
                              low    = ls_r-low
                              option = COND #( WHEN ls_r-low CS '*' OR ls_r-low CS '%' THEN 'CP'
                                               WHEN ls_r-low CS '!' THEN 'NE'
                                               ELSE ls_r-option )
                          ) ).
                WHEN 'REPORTINGORG'. mt_range_reporg = VALUE #( FOR ls_r IN ls_range-range (
                              sign   = ls_r-sign
                              low    = ls_r-low
                              option = COND #( WHEN ls_r-low CS '*' OR ls_r-low CS '%' THEN 'CP'
                                               WHEN ls_r-low CS '!' THEN 'NE'
                                               ELSE ls_r-option )
                          ) ).
                 WHEN 'PERSONNELAREA'.
                          mt_range_area = VALUE #( FOR ls_r IN ls_range-range (
                              sign   = ls_r-sign
                              low    = ls_r-low
                              option = COND #( WHEN ls_r-low CS '*' OR ls_r-low CS '%' THEN 'CP'
                                               WHEN ls_r-low CS '!' THEN 'NE'
                                               ELSE ls_r-option )
                          ) ).

                WHEN 'COUNTRY'. mt_range_country = VALUE #( FOR ls_r IN ls_range-range (
                              sign   = ls_r-sign
                              low    = ls_r-low
                              option = COND #( WHEN ls_r-low CS '*' OR ls_r-low CS '%' THEN 'CP'
                                               WHEN ls_r-low CS '!' THEN 'NE'
                                               ELSE ls_r-option )
                          ) ).

                WHEN 'POSITIONCODE'. mt_range_pos = VALUE #( FOR ls_r IN ls_range-range (
                              sign   = ls_r-sign
                              low    = ls_r-low
                              option = COND #( WHEN ls_r-low CS '*' OR ls_r-low CS '%' THEN 'CP'
                                               WHEN ls_r-low CS '!' THEN 'NE'
                                               ELSE ls_r-option )
                          ) ).

                WHEN 'EMPLOYMENTSTATUS'. mt_range_status = VALUE #( FOR ls_r IN ls_range-range (
                              sign   = ls_r-sign
                              low    = ls_r-low
                              option = COND #( WHEN ls_r-low CS '*' OR ls_r-low CS '%' THEN 'CP'
                                               WHEN ls_r-low CS '!' THEN 'NE'
                                               ELSE ls_r-option )
                          ) ).

                WHEN 'DIVISION'. mt_range_division = VALUE #( FOR ls_r IN ls_range-range (
                              sign   = ls_r-sign
                              low    = ls_r-low
                              option = COND #( WHEN ls_r-low CS '*' OR ls_r-low CS '%' THEN 'CP'
                                               WHEN ls_r-low CS '!' THEN 'NE'
                                               ELSE ls_r-option )
                          ) ).

                WHEN 'FUNCTION'. mt_range_func = VALUE #( FOR ls_r IN ls_range-range (
                        sign   = ls_r-sign
                              low    = COND #( WHEN ls_r-low CS '...' THEN segment( val = ls_r-low index = 1 sep = '...' )
                                               WHEN ls_r-low(1) = '!' THEN ls_r-low+1
                                               ELSE ls_r-low )

                              high   = COND #( WHEN ls_r-low CS '...' THEN segment( val = ls_r-low index = 2 sep = '...' )
                                               ELSE space )
                              option = COND #( WHEN ls_r-low CS '...'                  THEN 'BT'
                                               WHEN ls_r-low CS '*' OR ls_r-low CS '%' THEN 'CP'
                                               WHEN ls_r-low(1) = '!'                  THEN 'NE'
                                               ELSE ls_r-option ) ) ).

                WHEN 'SUBFUNCTION'. mt_range_subfunc = VALUE #( FOR ls_r IN ls_range-range (
                              sign   = ls_r-sign
                              low    = ls_r-low
                              option = COND #( WHEN ls_r-low CS '*' OR ls_r-low CS '%' THEN 'CP'
                                               WHEN ls_r-low CS '!' THEN 'NE'
                                               ELSE ls_r-option )
                          ) ).

                WHEN 'PERSONALSALARYGRADE'. mt_range_grade = VALUE #( FOR ls_r IN ls_range-range (
                              sign   = ls_r-sign
                              low    = ls_r-low
                              option = COND #( WHEN ls_r-low CS '*' OR ls_r-low CS '%' THEN 'CP'
                                               WHEN ls_r-low CS '!' THEN 'NE'
                                               ELSE ls_r-option )
                          ) ).

                WHEN 'EMPLOYEEGROUP'. mt_range_empgroup = VALUE #( FOR ls_r IN ls_range-range (
                              sign   = ls_r-sign
                              low    = ls_r-low
                              option = COND #( WHEN ls_r-low CS '*' OR ls_r-low CS '%' THEN 'CP'
                                               WHEN ls_r-low CS '!' THEN 'NE'
                                               ELSE ls_r-option )
                          ) ).



                WHEN 'CATEGORY'. mt_range_category = VALUE #( FOR ls_r IN ls_range-range (
                              sign   = ls_r-sign
                              low    = ls_r-low
                              option = COND #( WHEN ls_r-low CS '*' OR ls_r-low CS '%' THEN 'CP'
                                               WHEN ls_r-low CS '!' THEN 'NE'
                                               ELSE ls_r-option )
                          ) ).

                WHEN 'ISSALARIED'. mt_range_is_salaried = VALUE #( FOR ls_r IN ls_range-range (
                              sign   = ls_r-sign
                              low    = ls_r-low
                              option = COND #( WHEN ls_r-low CS '*' OR ls_r-low CS '%' THEN 'CP'
                                               WHEN ls_r-low CS '!' THEN 'NE'
                                               ELSE ls_r-option )
                          ) ).

                WHEN 'GENDER'. mt_range_gender = VALUE #( FOR ls_r IN ls_range-range (
                              sign   = ls_r-sign
                              low    = ls_r-low
                              option = COND #( WHEN ls_r-low CS '*' OR ls_r-low CS '%' THEN 'CP'
                                               WHEN ls_r-low CS '!' THEN 'NE'
                                               ELSE ls_r-option )
                          ) ).

                WHEN 'POTENTIAL_RATING'. mt_range_potential = VALUE #( FOR ls_r IN ls_range-range (
                              sign   = ls_r-sign
                              low    = ls_r-low
                              option = COND #( WHEN ls_r-low CS '*' OR ls_r-low CS '%' THEN 'CP'
                                               WHEN ls_r-low CS '!' THEN 'NE'
                                               ELSE ls_r-option )
                          ) ).
                WHEN 'NEWHIRE'. mt_range_new_hire = VALUE #( FOR ls_r IN ls_range-range (
                                              sign   = ls_r-sign
                                              low    = ls_r-low
                                              option = COND #( WHEN ls_r-low CS '*' OR ls_r-low CS '%' THEN 'CP'
                                                               WHEN ls_r-low CS '!' THEN 'NE'
                                                               ELSE ls_r-option )
                                          ) ).
                 ENDCASE.
        ENDLOOP.

    mt_parameter = VALUE cl_apj_rt_api=>tt_job_parameter_value(
            ( name = 'S_USERID'   t_value = CORRESPONDING #( mt_range_userid ) )
            ( name = 'S_AREA'     t_value = CORRESPONDING #( mt_range_area ) )
            ( name = 'S_COUNTRY'  t_value = CORRESPONDING #( mt_range_country ) )
            ( name = 'S_POSITION' t_value = CORRESPONDING #( mt_range_pos ) )
            ( name = 'S_STATUS'   t_value = CORRESPONDING #( mt_range_status ) )
            ( name = 'S_DIVISION' t_value = CORRESPONDING #( mt_range_division ) )
            ( name = 'S_NEWHIRE'   t_value = CORRESPONDING #( mt_range_new_hire ) )
            ( name = 'S_FUNC'     t_value = CORRESPONDING #( mt_range_func ) )
            ( name = 'S_SUBFUNC'  t_value = CORRESPONDING #( mt_range_subfunc ) )
            ( name = 'S_DEPT'     t_value = CORRESPONDING #( mt_range_department ) )
            ( name = 'S_GRADE'    t_value = CORRESPONDING #( mt_range_grade ) )
            ( name = 'S_EMPGROUP' t_value = CORRESPONDING #( mt_range_empgroup ) )
            ( name = 'S_REPORG'   t_value = CORRESPONDING #( mt_range_reporg ) )
            ( name = 'S_CATEGORY' t_value = CORRESPONDING #( mt_range_category ) )
            ( name = 'S_SALARIED' t_value = CORRESPONDING #( mt_range_is_salaried ) )
            ( name = 'S_GENDER'   t_value = CORRESPONDING #( mt_range_gender ) )
            ( name = 'S_POTENTIAL' t_value = CORRESPONDING #( mt_range_potential ) )
        ).

        TRY.
            cl_numberrange_runtime=>number_get(
              EXPORTING
                nr_range_nr = '01'
                object      = 'ZHR_NR_RPT'
              IMPORTING
                number      = DATA(lv_new_number) ).

          CATCH cx_number_ranges INTO DATA(lx_nr_error).
            lv_new_number = |{ cl_abap_context_info=>get_system_time( ) }|.
        ENDTRY.

        DATA(lv_report_id) = |CSR_{ lv_new_number+10(10) }|.
        APPEND VALUE #( name = 'S_RPTID'
                        t_value = VALUE #( ( sign = 'I' option = 'EQ' low = lv_report_id ) ) )
               TO mt_parameter.
        TRY.
            GET TIME STAMP FIELD DATA(ls_timestamp).
            DATA(ls_start) = VALUE cl_apj_rt_api=>ty_start_info( start_immediately = abap_true ).

            cl_apj_rt_api=>schedule_job(
                EXPORTING
                    iv_job_template_name   = 'ZHR_JT_CANDIDATESEARCH'
                    iv_job_text            = |CSR Data Extraction - { lv_report_id }|
                    is_start_info          = ls_start
                    it_job_parameter_value = mt_parameter
                IMPORTING
                    ev_jobname             = DATA(ld_jobname)
                    ev_jobcount            = DATA(ld_jobcount)
                    et_message             = DATA(lt_message)
            ).

            lv_status = 'Scheduled'.
            lv_error_message = 'Scheduled'.

        CATCH cx_apj_rt INTO DATA(lo_error).
            lv_status = 'Failed'.
            IF lt_message IS NOT INITIAL.
                lv_error_message = lt_message[ 1 ]-message.
            ELSE.
                lv_error_message = lo_error->get_text( ).
            ENDIF.
        ENDTRY.

        DATA(ls_runlog) = VALUE zhrt_csr_runlog(
            reportid  = lv_report_id
            jobcount  = ld_jobcount
            status    = lv_status
            createdby = sy-uname
            createdon = cl_abap_context_info=>get_system_date( )
            createdat = cl_abap_context_info=>get_system_time( )
            filename  = ''
        ).


            IF lv_status = 'Failed'.
                lt_response = VALUE #( ( jobcount = ''
                                         jobname  = ''
                                         reportid = ''
                                         message  = |Error: { lv_error_message }| ) ).
            ELSE.
                lt_response = VALUE #( ( jobcount = ld_jobcount
                                         jobname  = ld_jobname
                                         reportid = lv_report_id
                                         message  = 'Job Scheduled Successfully' ) ).
            ENDIF.

            io_response->set_data( lt_response ).
            io_response->set_total_number_of_records( LINES( lt_response ) ).
            ENDIF.

         IF io_request->is_total_numb_of_rec_requested( ).
            io_response->set_total_number_of_records( 1 ).
        ENDIF.


    ENDMETHOD.
ENDCLASS.
